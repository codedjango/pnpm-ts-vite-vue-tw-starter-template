{
	"name": "pnpm-vite-vue-ts-starter",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vue-tsc -b && vite build",
		"preview": "vite preview",
		"lint": "oxlint --fix",
		"typecheck": "vue-tsc --noEmit",
		"fmt": "oxfmt --write .",
		"format": "pnpm typecheck && pnpm lint && pnpm fmt"
	},
	"dependencies": {
		"@vueuse/core": "^14.4.0",
		"pinia": "^4.0.3",
		"vue": "^3.5.41",
		"vue-router": "^5.2.0"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.2.0",
		"@types/web": "^0.0.354",
		"@vitejs/plugin-vue": "^6.0.8",
		"@vue/tsconfig": "^0.9.1",
		"oxfmt": "^0.63.0",
		"oxlint": "^1.78.0",
		"tailwindcss": "^4.3.3",
		"typescript": "~6.0.3",
		"vite": "^8.2.1",
		"vite-plugin-vue-devtools": "^8.2.1",
		"vue-tsc": "^3.3.9"
	}
}
